# Copy to .env (gitignored) and fill in. The Meek eval auto-loads .env.
# These are the credentials that currently BLOCK running the eval half.

# OpenRouter: serves off-the-shelf teachers + the qwq-32b judge candidate.
OPENROUTER_API_KEY=

# Anthropic: the claude-sonnet-4-6 judge candidate (judge validation, spec 10.3).
ANTHROPIC_API_KEY=

# HuggingFace: gated GPQA-Diamond + Meek's ameek/causal_factors dataset.
# Also mirror this as a Modal Secret named "huggingface" for GPU jobs (spec 12):
#   modal secret create huggingface HF_TOKEN=hf_...
HF_TOKEN=
